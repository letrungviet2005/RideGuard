# Reference only. Spring does not automatically load this file.
DB_URL=jdbc:postgresql://localhost:5432/rideguard
DB_USER=rideguard
DB_PASSWORD=
PORT=8080
# Independent random base64 keys, >=32 bytes each. No production defaults.
JWT_SIGNING_KEY=
CURSOR_SIGNING_KEY=
ADMIN_ALLOWED_ORIGINS=https://admin.example.invalid
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.invalid
SMTP_AUTH=true
SMTP_STARTTLS=true
RATE_LIMIT_PER_MINUTE=120
REPORTS_RETENTION_DAYS=30
# For HTTP localhost only: explicitly select local profile and COOKIE_SECURE=false.
# SPRING_PROFILES_ACTIVE=local
# Integration tests use a DIFFERENT database, name must end in _test.
# TEST_DB_URL=jdbc:postgresql://localhost:5433/rideguard_test
# TEST_DB_USER=rideguard_test
# TEST_DB_PASSWORD=
# Optional migration upgrade test: a separate, fresh database ending in _test.
# TEST_MIGRATION_DB_URL=jdbc:postgresql://localhost:5433/rideguard_migration_test
