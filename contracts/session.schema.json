{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "source",
    "stage",
    "started_at",
    "sensor",
    "firmware_revision",
    "clock_id",
    "split",
    "contains_location",
    "distance_definition",
    "label_protocol_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "enum": [
        "real",
        "simulated"
      ]
    },
    "stage": {
      "enum": [
        "raw",
        "processed",
        "labeled",
        "simulated"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "sensor": {
      "enum": [
        "LD2451",
        "LD2417"
      ]
    },
    "firmware_revision": {
      "type": "string",
      "minLength": 1
    },
    "clock_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "unassigned",
        "train",
        "validation",
        "test"
      ]
    },
    "contains_location": {
      "type": "boolean",
      "description": "Provenance flag for externally collected research data; MVP collection must set false. This does not enable a backend GPS/trip feature; never commit private location data."
    },
    "distance_definition": {
      "enum": [
        "unspecified",
        "radial",
        "axis_y"
      ]
    },
    "label_protocol_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "imu_sensor": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "LSM6DS3",
        "BMI160",
        null
      ],
      "description": "Actual verified module when known, otherwise null. Optional for older collection manifests."
    },
    "imu_clock_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Clock domain of IMU samples if known; not assumed to equal radar clock_id."
    },
    "clock_alignment": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "SAME_CLOCK",
        "ALIGNED"
      ],
      "description": "UNKNOWN unless evidenced. ALIGNED requires separately recorded transform/error budget before features are usable."
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "session_id": "00000000-0000-4000-8000-000000000001",
      "source": "simulated",
      "stage": "simulated",
      "started_at": "2026-11-06T00:00:00Z",
      "sensor": "LD2451",
      "firmware_revision": "example-only",
      "clock_id": "example-boot",
      "split": "unassigned",
      "contains_location": false,
      "distance_definition": "unspecified",
      "label_protocol_version": null,
      "imu_sensor": null,
      "imu_clock_id": null,
      "clock_alignment": "UNKNOWN"
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "simulated"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "const": "simulated"
          }
        }
      }
    }
  ],
  "description": "Proposed offline research collection provenance, not auth sessions or trip history. MVP collection does not record GPS routes. Optional IMU/clock metadata does not prove hardware presence or alignment; absent alignment is UNKNOWN."
}
