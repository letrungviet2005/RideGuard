{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "binding_id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "schema_version": {
      "type": "integer",
      "const": 1,
      "readOnly": true
    },
    "desired_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "readOnly": true
    },
    "reported_applied_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991,
      "readOnly": true
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_brightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "vibration_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "display_brightness",
        "vibration_enabled"
      ]
    }
  },
  "required": [
    "binding_id",
    "schema_version",
    "desired_version",
    "reported_applied_version",
    "settings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device configuration v1 — proposed",
  "description": "Proposed MVP snapshot. Applied version must reference an issued version on this binding and never exceed desired_version (service/DB invariant). Vibration preference cannot disable core safety warnings; firmware precedence needs approval.",
  "examples": [
    {
      "binding_id": "00000000-0000-4000-8000-000000000003",
      "schema_version": 1,
      "desired_version": 2,
      "reported_applied_version": 1,
      "settings": {
        "display_brightness": 70,
        "vibration_enabled": true
      }
    }
  ]
}
